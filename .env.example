# ---- Database -------------------------------------------------------------
# Production: a PostgreSQL connection string (Neon / Supabase / any Postgres 14+).
# Leave empty in local development to use the embedded PGlite database in ./.data/pglite
# (development only — the app refuses to start in production without DATABASE_URL).
DATABASE_URL=

# ---- Security -------------------------------------------------------------
# Random string, at least 32 characters. Signs the anonymous learner cookie and the admin session.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Passphrase for /admin. Use a long random value in production.
ADMIN_PASSWORD=

# ---- AI providers (optional) ---------------------------------------------
# Without these keys, Writing/Speaking submissions are still saved and shown with
# a "grading unavailable" status plus a self-assessment checklist.
ANTHROPIC_API_KEY=
# Model used for rubric-based Writing / Speaking feedback (default: claude-opus-5-5).
ANTHROPIC_MODEL=claude-opus-5-5
# Speech-to-text for Speaking, and the optional production-quality TTS for Listening audio.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Operations -----------------------------------------------------------
# Bearer token for GET /api/cron/maintenance (retention job). Vercel Cron sends it automatically.
CRON_SECRET=
# Shown on the contact page.
SUPPORT_EMAIL=

# ---- Cost controls --------------------------------------------------------
# Max AI grading requests per learner per 24h.
AI_DAILY_LIMIT_PER_LEARNER=10
